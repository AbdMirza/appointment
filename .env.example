# Copy to .env in project root (for docker-compose) or backend/.env for local dev

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appointment_db?schema=public

# Auth
JWT_SECRET=change-this-to-a-long-random-secret

# Server
PORT=5000
FRONTEND_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Appointment App

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis (notifications queue)
REDIS_URL=redis://localhost:6379

# Frontend (local npm start only — Docker uses /api via nginx proxy)
REACT_APP_API_URL=http://localhost:5000/api
