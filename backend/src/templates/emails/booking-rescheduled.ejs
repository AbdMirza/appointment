<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background-color: #f59e0b; color: white; padding: 20px; border-radius: 10px 10px 0 0; text-align: center; }
        .content { border: 1px solid #e5e7eb; border-top: none; padding: 30px; border-radius: 0 0 10px 10px; }
        .details { background-color: #fffbeb; padding: 20px; border-radius: 8px; margin: 20px 0; border: 1px solid #fef3c7; }
        .footer { text-align: center; margin-top: 30px; color: #6b7280; font-size: 12px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Appointment Rescheduled</h1>
    </div>
    <div class="content">
        <p>Hello <%= customerName %>,</p>
        <p>Your appointment has been successfully rescheduled to a new time.</p>
        
        <div class="details">
            <h3 style="margin-top: 0; color: #f59e0b;">New Appointment Details</h3>
            <p><strong>Service:</strong> <%= serviceName %></p>
            <p><strong>New Date:</strong> <%= date %></p>
            <p><strong>New Time:</strong> <%= time %></p>
        </div>

        <div class="details" style="opacity: 0.7;">
            <h4 style="margin-top: 0;">Previous Time</h4>
            <p><%= oldDate %> at <%= oldTime %></p>
        </div>

        <p>We look forward to seeing you at the new time!</p>
        
        <div class="footer">
            <p>&copy; <%= new Date().getFullYear() %> Appointment System. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
